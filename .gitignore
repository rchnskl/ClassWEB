# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment
.env
.env.*
!.env.example
# Client-side public config, baked into the browser bundle at build time and
# therefore not secret. Committed so a deploy can never silently fall back to
# localhost because whoever ran it didn't have the variable exported.
!apps/web/.env.production

# Prisma
packages/database/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / coverage
coverage/
.nyc_output/

# Backups (runtime-generated)
storage/backups/*
!storage/backups/.gitkeep

# Uploaded files (runtime-generated)
storage/uploads/*
!storage/uploads/.gitkeep

# Claude Code local overrides
.claude/settings.local.json

# TS incremental build info
*.tsbuildinfo
apps/api/test/.pgdata-e2e/
scratchpad/.pgdata-dev/

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/

# Cloudflare (OpenNext build output + wrangler local state)
apps/web/.open-next/
apps/web/.wrangler/
.wrangler/
