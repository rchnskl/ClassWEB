// =============================================================================
//  ClassWeb — Enterprise Classroom & Attendance Platform
//  Faculty of Nursing, Assumption University
//
//  DATA MODEL (source of truth). Phase 1 deliverable.
//
//  Design principles
//  -----------------
//  * Multi-tenant by design. `University` is the tenant root. Every
//    tenant-owned, directly-queried table carries a denormalised
//    `universityId` so Postgres Row-Level-Security / a scoping guard can
//    filter every query by tenant with a single indexed predicate. New
//    faculties / campuses / programs are DATA, never migrations.
//  * Academic hierarchy is modelled exactly as specified:
//      University → Campus/Faculty → Department/Program →
//      AcademicYear → Semester → Course → Subject → Section → Enrollment(Student)
//  * Every table is auditable: createdAt / updatedAt everywhere,
//    soft-delete (deletedAt) on the major aggregates, and a dedicated
//    AuditLog for every mutating action.
//  * Extensible for the ~30 future modules (gradebook, OSCE, clinical
//    logbook, portfolio, …) via stable FKs, JSON `metadata` escape hatches
//    on core entities, and a generic Attachment table — WITHOUT reshaping
//    any existing table.
//
//  See docs/architecture/data-model.md for the ERD and rationale.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
//  ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

/// Current enrolment/study status of a student.
enum StudentStatus {
  STUDYING
  ON_LEAVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  DISMISSED
  TRANSFERRED
}

/// Separate from StudentStatus because the spec tracks graduation explicitly.
enum GraduationStatus {
  NOT_GRADUATED
  IN_PROGRESS
  GRADUATED
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  WITHDRAWN
  COMPLETED
  FAILED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  LEAVE
}

/// How an attendance record was captured. GPS/Bluetooth/Face are wired now
/// as first-class values so the future capture methods need no migration.
enum AttendanceMethod {
  MANUAL
  QR_CODE
  GPS
  BLUETOOTH
  FACE_RECOGNITION
}

enum ClassSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  HOLIDAY
  POSTPONED
  MAKEUP
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SemesterType {
  FIRST
  SECOND
  SUMMER
  SPECIAL
}

enum CalendarEventType {
  HOLIDAY
  SPECIAL_EVENT
  EXAM
  CLASS_CANCELLATION
  MAKEUP_CLASS
}

enum NotificationChannel {
  EMAIL
  LINE
  PUSH
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum BackupType {
  MANUAL
  AUTOMATIC
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Scope at which a configurable setting or attendance rule applies.
/// Resolution is most-specific-wins (SECTION > SEMESTER > PROGRAM > FACULTY > UNIVERSITY > SYSTEM).
enum ConfigScope {
  SYSTEM
  UNIVERSITY
  FACULTY
  PROGRAM
  SEMESTER
  SECTION
}

enum AttachmentType {
  STUDENT_PHOTO
  LECTURER_PHOTO
  SIGNATURE
  UNIVERSITY_LOGO
  FACULTY_LOGO
  DOCUMENT
  QR_CODE
  REPORT
  OTHER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  EXPORT
  IMPORT
  ATTENDANCE
  SETTINGS_CHANGE
  BACKUP
  RESTORE
  VIEW
}

// =============================================================================
//  TENANCY & ACADEMIC HIERARCHY
// =============================================================================

/// Tenant root. Everything below belongs to exactly one University.
model University {
  id          String    @id @default(cuid())
  code        String    @unique // e.g. "AU"
  nameEn      String
  nameTh      String?
  shortName   String?
  logoId      String?
  websiteUrl  String?
  contactInfo Json? // phone / email / address structured payload
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  logo            Attachment?      @relation("UniversityLogo", fields: [logoId], references: [id])
  campuses        Campus[]
  faculties       Faculty[]
  academicYears   AcademicYear[]
  users           User[]
  students        Student[]
  lecturers       Lecturer[]
  settings        Setting[]
  auditLogs       AuditLog[]
  attachments     Attachment[]
  backups         Backup[]
  sections        Section[]
  attendanceRules AttendanceRule[]
  calendarEvents  CalendarEvent[]
  calendarEntries CalendarEntry[]
  studentNotes    StudentNote[]
  reports         Report[]
  rubrics         Rubric[]
  evaluations     Evaluation[]
  gradeSchemes    GradeScheme[]

  @@index([isActive])
  @@map("universities")
}

model Campus {
  id           String    @id @default(cuid())
  universityId String
  code         String
  nameEn       String
  nameTh       String?
  address      String?
  city         String?
  country      String?   @default("Thailand")
  timezone     String    @default("Asia/Bangkok")
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  university University @relation(fields: [universityId], references: [id])
  buildings  Building[]

  @@unique([universityId, code])
  @@index([universityId])
  @@map("campuses")
}

model Faculty {
  id           String    @id @default(cuid())
  universityId String
  code         String // e.g. "NURSING"
  nameEn       String
  nameTh       String?
  logoId       String?
  deanName     String?
  contactInfo  Json?
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  university  University   @relation(fields: [universityId], references: [id])
  logo        Attachment?  @relation("FacultyLogo", fields: [logoId], references: [id])
  departments Department[]
  programs    Program[]
  lecturers   Lecturer[]

  @@unique([universityId, code])
  @@index([universityId])
  @@map("faculties")
}

model Department {
  id        String    @id @default(cuid())
  facultyId String
  code      String
  nameEn    String
  nameTh    String?
  headId    String? // lecturer who heads the department
  isActive  Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  faculty   Faculty    @relation(fields: [facultyId], references: [id])
  head      Lecturer?  @relation("DepartmentHead", fields: [headId], references: [id])
  lecturers Lecturer[] @relation("LecturerDepartment")

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("departments")
}

/// A degree program, e.g. "Bachelor of Nursing Science".
model Program {
  id           String    @id @default(cuid())
  facultyId    String
  code         String
  nameEn       String
  nameTh       String?
  degreeType   String? // e.g. "Bachelor", "Master"
  durationYrs  Int?      @default(4)
  totalCredits Int?
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  faculty  Faculty   @relation(fields: [facultyId], references: [id])
  courses  Course[]
  subjects Subject[]
  students Student[]

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("programs")
}

/// A university-wide academic year, e.g. "2026" (Buddhist year 2569).
model AcademicYear {
  id           String    @id @default(cuid())
  universityId String
  code         String // e.g. "2026"
  nameEn       String // e.g. "Academic Year 2026"
  nameTh       String?
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  isCurrent    Boolean   @default(false)
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  university University @relation(fields: [universityId], references: [id])
  semesters  Semester[]

  @@unique([universityId, code])
  @@index([universityId])
  @@map("academic_years")
}

model Semester {
  id              String       @id @default(cuid())
  academicYearId  String
  type            SemesterType
  nameEn          String // e.g. "First Semester"
  nameTh          String?
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  /// Cut-off after which enrolment/attendance edits are locked.
  addDropDeadline DateTime?    @db.Date
  isCurrent       Boolean      @default(false)
  isActive        Boolean      @default(true)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  sections       Section[]
  calendarEvents CalendarEvent[]

  @@unique([academicYearId, type])
  @@index([academicYearId])
  @@map("semesters")
}

// =============================================================================
//  CURRICULUM: Course → Subject → Section
//
//  Course   = an (optional) curriculum grouping owned by a Program.
//  Subject  = the teachable catalogue unit (Course Code, Description, Credits).
//             Belongs to a Program; MAY belong to a Course.
//  Section  = a concrete offering of a Subject within a Semester (teacher,
//             room, schedule, capacity, enrolment).
//
//  Course is nullable on Subject so faculties that do not use the Course
//  grouping still work. See data-model.md for the rationale.
// =============================================================================

model Course {
  id          String    @id @default(cuid())
  programId   String
  code        String
  nameEn      String
  nameTh      String?
  description String?
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  program  Program   @relation(fields: [programId], references: [id])
  subjects Subject[]

  @@unique([programId, code])
  @@index([programId])
  @@map("courses")
}

model Subject {
  id          String    @id @default(cuid())
  programId   String
  courseId    String // every subject belongs to a curriculum Course (confirmed by faculty)
  code        String // Course Code, e.g. "NUR1101"
  nameEn      String
  nameTh      String?
  description String? // Course Description
  credits     Int       @default(3)
  /// Contact-hour breakdown, e.g. { "lecture": 2, "lab": 3, "clinical": 0 }.
  creditHours Json?
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  program        Program         @relation(fields: [programId], references: [id])
  course         Course          @relation(fields: [courseId], references: [id])
  sections       Section[]
  subjectRubrics SubjectRubric[]

  @@unique([programId, code])
  @@index([programId])
  @@index([courseId])
  @@map("subjects")
}

model Section {
  id                String    @id @default(cuid())
  universityId      String // denormalised tenant key
  subjectId         String
  semesterId        String
  lecturerId        String? // primary lecturer
  roomId            String? // default room
  sectionNo         String // e.g. "001"
  capacity          Int       @default(40)
  /// Maintained by the enrolment service; denormalised for fast dashboards.
  currentEnrollment Int       @default(0)
  isActive          Boolean   @default(true)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  university      University        @relation(fields: [universityId], references: [id], map: "sections_university_fk")
  subject         Subject           @relation(fields: [subjectId], references: [id])
  semester        Semester          @relation(fields: [semesterId], references: [id])
  lecturer        Lecturer?         @relation("SectionPrimaryLecturer", fields: [lecturerId], references: [id])
  room            Room?             @relation(fields: [roomId], references: [id])
  coLecturers     SectionLecturer[]
  schedules       SectionSchedule[]
  classSessions   ClassSession[]
  enrollments     Enrollment[]
  attendanceRules AttendanceRule[]
  evaluations     Evaluation[]

  @@unique([subjectId, semesterId, sectionNo])
  @@index([universityId])
  @@index([semesterId])
  @@index([lecturerId])
  @@map("sections")
}

/// Additional (co-)teachers on a section beyond the primary lecturer.
model SectionLecturer {
  id         String   @id @default(cuid())
  sectionId  String
  lecturerId String
  role       String?  @default("CO_LECTURER") // CO_LECTURER, TA, CLINICAL_PRECEPTOR
  createdAt  DateTime @default(now())

  section  Section  @relation(fields: [sectionId], references: [id])
  lecturer Lecturer @relation(fields: [lecturerId], references: [id])

  @@unique([sectionId, lecturerId])
  @@index([lecturerId])
  @@map("section_lecturers")
}

// =============================================================================
//  ROOMS
// =============================================================================

model Building {
  id        String    @id @default(cuid())
  campusId  String
  code      String
  nameEn    String
  nameTh    String?
  floors    Int?      @default(1)
  isActive  Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campus Campus @relation(fields: [campusId], references: [id])
  rooms  Room[]

  @@unique([campusId, code])
  @@index([campusId])
  @@map("buildings")
}

model Room {
  id         String     @id @default(cuid())
  buildingId String
  roomNumber String
  nameEn     String?
  floor      Int?
  capacity   Int        @default(0)
  /// Structured list, e.g. ["projector","whiteboard","manikin"].
  equipment  Json?
  status     RoomStatus @default(AVAILABLE)
  isBookable Boolean    @default(true)
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  building         Building          @relation(fields: [buildingId], references: [id])
  sections         Section[]
  sectionSchedules SectionSchedule[]
  classSessions    ClassSession[]
  calendarEntries  CalendarEntry[]

  @@unique([buildingId, roomNumber])
  @@index([buildingId])
  @@index([status])
  @@map("rooms")
}

// =============================================================================
//  TIMETABLE: recurring schedule + concrete class sessions
//
//  SectionSchedule = the recurring weekly meeting pattern (used to render the
//                    weekly/monthly timetable and to detect room/teacher/
//                    section conflicts).
//  ClassSession    = a concrete dated occurrence (generated from the schedule
//                    or created ad-hoc for make-ups). Attendance attaches here.
// =============================================================================

model SectionSchedule {
  id            String    @id @default(cuid())
  sectionId     String
  roomId        String?
  lecturerId    String?
  dayOfWeek     DayOfWeek
  startTime     String // "HH:mm" 24h, campus-local
  endTime       String
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  section  Section   @relation(fields: [sectionId], references: [id])
  room     Room?     @relation(fields: [roomId], references: [id])
  lecturer Lecturer? @relation(fields: [lecturerId], references: [id])

  @@index([sectionId])
  @@index([roomId, dayOfWeek])
  @@index([lecturerId, dayOfWeek])
  @@map("section_schedules")
}

model ClassSession {
  id               String             @id @default(cuid())
  sectionId        String
  roomId           String?
  lecturerId       String?
  sessionDate      DateTime           @db.Date
  startTime        String // "HH:mm"
  endTime          String
  status           ClassSessionStatus @default(SCHEDULED)
  topic            String?
  isMakeup         Boolean            @default(false)
  /// When attendance capture closes (derived from AttendanceRule.lockAfterMinutes).
  attendanceLockAt DateTime?
  cancelReason     String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  section            Section             @relation(fields: [sectionId], references: [id])
  room               Room?               @relation(fields: [roomId], references: [id])
  lecturer           Lecturer?           @relation(fields: [lecturerId], references: [id])
  attendance         AttendanceRecord[]
  attendanceSessions AttendanceSession[]

  @@unique([sectionId, sessionDate, startTime])
  @@index([sectionId])
  @@index([sessionDate])
  @@index([roomId, sessionDate])
  @@map("class_sessions")
}

// =============================================================================
//  PEOPLE: User (auth) + Student + Lecturer profiles
// =============================================================================

/// Authentication principal. Students and lecturers optionally link to a User
/// (a student record can exist before the student ever logs in).
model User {
  id           String     @id @default(cuid())
  universityId String
  email        String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  /// LINE Messaging API user id (obtained once the user links their LINE account); enables the LINE notification channel for this user.
  lineUserId   String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  university               University                @relation(fields: [universityId], references: [id])
  roles                    UserRole[]
  refreshTokens            RefreshToken[]
  student                  Student?
  lecturer                 Lecturer?
  auditLogs                AuditLog[]
  notifications            Notification[]
  googleCalendarConnection GoogleCalendarConnection?
  pushSubscriptions        PushSubscription[]

  @@unique([universityId, email])
  @@index([universityId])
  @@map("users")
}

model Student {
  id           String  @id @default(cuid())
  universityId String
  programId    String
  userId       String? @unique

  studentCode String // Student ID
  citizenId   String? // optional
  passportNo  String?

  nameEn    String
  nameTh    String?
  nickname  String?
  gender    Gender    @default(UNSPECIFIED)
  birthDate DateTime? @db.Date
  email     String?
  phone     String?

  emergencyContact Json? // { name, relation, phone }
  parentContact    Json?
  address          Json?

  photoId String?
  qrCode  String? @unique // encoded student QR payload / token

  admissionYear Int?
  status        StudentStatus    @default(STUDYING)
  graduation    GraduationStatus @default(NOT_GRADUATED)
  graduatedAt   DateTime?        @db.Date

  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  university   University         @relation(fields: [universityId], references: [id])
  program      Program            @relation(fields: [programId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  photo        Attachment?        @relation("StudentPhoto", fields: [photoId], references: [id])
  enrollments  Enrollment[]
  attendance   AttendanceRecord[]
  studentNotes StudentNote[]
  evaluations  Evaluation[]

  @@unique([universityId, studentCode])
  @@index([universityId])
  @@index([programId])
  @@index([status])
  @@map("students")
}

model Lecturer {
  id           String  @id @default(cuid())
  universityId String
  facultyId    String?
  departmentId String?
  userId       String? @unique

  employeeCode String // Employee ID
  nameEn       String
  nameTh       String?
  position     String?
  email        String?
  phone        String?
  office       String?
  officeHours  Json? // structured availability

  photoId             String?
  signatureId         String? // signature image
  /// Opaque digital-signature material / key reference (never a private key value).
  digitalSignatureRef String?

  isActive  Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  university        University        @relation(fields: [universityId], references: [id])
  faculty           Faculty?          @relation(fields: [facultyId], references: [id])
  department        Department?       @relation("LecturerDepartment", fields: [departmentId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
  photo             Attachment?       @relation("LecturerPhoto", fields: [photoId], references: [id])
  signature         Attachment?       @relation("LecturerSignature", fields: [signatureId], references: [id])
  headedDepartments Department[]      @relation("DepartmentHead")
  primarySections   Section[]         @relation("SectionPrimaryLecturer")
  coSections        SectionLecturer[]
  sectionSchedules  SectionSchedule[]
  classSessions     ClassSession[]
  calendarEntries   CalendarEntry[]

  @@unique([universityId, employeeCode])
  @@index([universityId])
  @@index([departmentId])
  @@map("lecturers")
}

// =============================================================================
//  ENROLLMENT & ATTENDANCE
// =============================================================================

model Enrollment {
  id             String           @id @default(cuid())
  sectionId      String
  studentId      String
  status         EnrollmentStatus @default(ENROLLED)
  enrollDate     DateTime         @default(now())
  dropDate       DateTime?
  dropReason     String?
  /// Final attendance percentage snapshot (maintained by analytics).
  attendanceRate Float?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  section    Section            @relation(fields: [sectionId], references: [id])
  student    Student            @relation(fields: [studentId], references: [id])
  attendance AttendanceRecord[]

  @@unique([sectionId, studentId])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
  @@map("enrollments")
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  classSessionId String
  enrollmentId   String
  studentId      String // denormalised for fast per-student analytics
  status         AttendanceStatus @default(ABSENT)
  method         AttendanceMethod @default(MANUAL)
  checkInAt      DateTime?
  /// Minutes late relative to session start (computed at capture time).
  minutesLate    Int?
  /// Geolocation payload for GPS attendance ({ lat, lng, accuracy }).
  geo            Json?
  remark         String?
  recordedById   String? // user who captured/edited the record
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id])
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([classSessionId, enrollmentId])
  @@index([studentId])
  @@index([classSessionId])
  @@index([status])
  @@map("attendance_records")
}

/// Configurable attendance rule engine. Rules resolve most-specific-scope-wins.
model AttendanceRule {
  id           String      @id @default(cuid())
  universityId String
  scope        ConfigScope @default(UNIVERSITY)
  /// Set when scope == SECTION; null for broader scopes.
  sectionId    String?
  name         String      @default("Default attendance policy")

  lateAfterMinutes       Int     @default(15)
  autoAbsentAfterMinutes Int     @default(60)
  /// Minutes after session start when capture locks.
  lockAfterMinutes       Int?    @default(120)
  /// Weight of attendance in overall assessment (0..100).
  attendanceWeight       Float   @default(0)
  countWeekend           Boolean @default(false)
  countHoliday           Boolean @default(false)
  /// Thresholds that drive the risk analytics (below X% => warning/risk).
  warningThreshold       Float   @default(80)
  riskThreshold          Float   @default(70)
  criticalThreshold      Float   @default(60)

  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id])
  section    Section?   @relation(fields: [sectionId], references: [id])

  @@index([universityId, scope])
  @@index([sectionId])
  @@map("attendance_rules")
}

/// Academic-calendar events: holidays, special events, cancellations, make-ups.
/// Drives the holiday/weekend rules in attendance generation.
model CalendarEvent {
  id           String            @id @default(cuid())
  universityId String
  semesterId   String?
  type         CalendarEventType
  nameEn       String
  nameTh       String?
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  isRecurring  Boolean           @default(false)
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  university University @relation(fields: [universityId], references: [id])
  semester   Semester?  @relation(fields: [semesterId], references: [id])

  @@index([universityId, type])
  @@index([startDate])
  @@map("calendar_events")
}

// =============================================================================
//  SECURITY: RBAC (role/permission matrix) + refresh tokens
// =============================================================================

model Role {
  id           String   @id @default(cuid())
  /// Null = a system-wide role template shared by all tenants.
  universityId String?
  code         String // e.g. "ADMIN", "LECTURER", "STUDENT"
  nameEn       String
  nameTh       String?
  description  String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([universityId, code])
  @@map("roles")
}

/// A granular permission, e.g. resource="attendance", action="update".
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // "attendance:update"
  resource    String // "attendance"
  action      String // "create" | "read" | "update" | "delete" | "export" | ...
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  /// Optional scoping of the grant (e.g. lecturer-admin only within a faculty).
  scopeType String?
  scopeId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// Store a hash of the token, never the token itself.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
//  CROSS-CUTTING: attachments, settings, notifications, audit, backups
// =============================================================================

/// Generic file/asset metadata. Reused now (photos, signatures, logos, QR,
/// reports) and by every future module (documents, portfolios, certificates)
/// without schema changes.
model Attachment {
  id           String         @id @default(cuid())
  universityId String
  type         AttachmentType @default(OTHER)
  fileName     String
  mimeType     String
  sizeBytes    Int?
  /// Storage key/path (S3 key, disk path, …). Never a public URL secret.
  storageKey   String
  checksum     String?
  uploadedById String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  university University @relation(fields: [universityId], references: [id])

  universityLogos    University[] @relation("UniversityLogo")
  facultyLogos       Faculty[]    @relation("FacultyLogo")
  studentPhotos      Student[]    @relation("StudentPhoto")
  lecturerPhotos     Lecturer[]   @relation("LecturerPhoto")
  lecturerSignatures Lecturer[]   @relation("LecturerSignature")

  @@index([universityId, type])
  @@map("attachments")
}

/// Configurable settings resolved most-specific-scope-wins. Value is JSON so a
/// single table backs logos, theme, PDF header/footer, email server config,
/// backup schedule, attendance defaults, etc.
model Setting {
  id           String      @id @default(cuid())
  universityId String
  scope        ConfigScope @default(UNIVERSITY)
  scopeId      String? // e.g. facultyId/semesterId when scope is narrower
  key          String // e.g. "theme.primaryColor", "pdf.footer", "email.smtp"
  value        Json
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, scope, scopeId, key])
  @@index([universityId, scope])
  @@map("settings")
}

model Notification {
  id           String              @id @default(cuid())
  universityId String
  userId       String? // recipient (null for broadcast)
  channel      NotificationChannel @default(SYSTEM)
  status       NotificationStatus  @default(PENDING)
  type         String // "ATTENDANCE_SUBMITTED", "STUDENT_ABSENT", "BELOW_80", "CLASS_CANCELLED", ...
  title        String
  body         String?
  /// Loosely-coupled reference to any entity (studentId, sectionId, …).
  refType      String?
  refId        String?
  payload      Json?
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([universityId])
  @@index([userId, status])
  @@index([type])
  @@map("notifications")
}

/// Immutable audit trail for every mutating/authentication action.
model AuditLog {
  id           String      @id @default(cuid())
  universityId String?
  userId       String?
  action       AuditAction
  entityType   String? // "Student", "AttendanceRecord", ...
  entityId     String?
  /// before/after diff or request context.
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  university University? @relation(fields: [universityId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([universityId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model Backup {
  id           String       @id @default(cuid())
  universityId String?
  type         BackupType   @default(MANUAL)
  status       BackupStatus @default(PENDING)
  fileName     String?
  storageKey   String?
  sizeBytes    Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String?
  error        String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  university University? @relation(fields: [universityId], references: [id])

  @@index([universityId, createdAt])
  @@index([status])
  @@map("backups")
}

// =============================================================================
//  CALENDAR: unified timetable entries (classes, personal appointments,
//  lecturer activities/meetings) + Google Calendar connection (sync-ready).
//
//  Class *sessions* still live in ClassSession (generated from the recurring
//  SectionSchedule). CalendarEntry holds concrete, dated non-recurring items
//  and can also mirror class sessions when a unified agenda is needed. Google
//  sync fields stay null until a GoogleCalendarConnection is authorised.
// =============================================================================

enum CalendarEntryType {
  CLASS
  EXAM
  PERSONAL
  ACTIVITY
  MEETING
  OTHER
}

enum CalendarVisibility {
  PRIVATE
  FACULTY
  PUBLIC
}

model CalendarEntry {
  id           String             @id @default(cuid())
  universityId String
  type         CalendarEntryType  @default(PERSONAL)
  visibility   CalendarVisibility @default(PRIVATE)
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean            @default(false)
  location     String?
  roomId       String?
  /// Owner (personal appointment / activity organiser). Null for faculty-wide.
  lecturerId   String?
  createdById  String?
  color        String?

  // Google Calendar sync — populated only when a connection is authorised.
  googleEventId    String?
  googleCalendarId String?
  syncedAt         DateTime?

  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  university University @relation(fields: [universityId], references: [id])
  room       Room?      @relation(fields: [roomId], references: [id])
  lecturer   Lecturer?  @relation(fields: [lecturerId], references: [id])

  @@index([universityId, startAt])
  @@index([lecturerId])
  @@index([type])
  @@map("calendar_entries")
}

/// Per-user Google Calendar authorisation. Tokens are app-encrypted at rest.
/// Architecture is in place now; the OAuth flow is wired when credentials exist.
model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  googleEmail  String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  calendarId   String?   @default("primary")
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("google_calendar_connections")
}

/// Web Push subscription (browser Push API). One row per browser/device the
/// user has enabled notifications on; a user may have several.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
//  STUDENT NOTES — append-only behaviour / daily log kept as evidence.
//  Each note is stamped with the recorder's name and the moment it was written
//  (immutable snapshot), so it stands as a record even if the author changes.
// =============================================================================

enum StudentNoteCategory {
  BEHAVIOR
  INCIDENT
  ACADEMIC
  HEALTH
  GENERAL
}

model StudentNote {
  id           String              @id @default(cuid())
  universityId String
  studentId    String
  category     StudentNoteCategory @default(BEHAVIOR)
  content      String
  /// Immutable snapshot of the recorder at write time (evidence stamp).
  authorUserId String?
  authorName   String
  /// Marks notes describing misconduct for quick filtering.
  flagged      Boolean             @default(false)
  metadata     Json?
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?

  university University @relation(fields: [universityId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([universityId])
  @@map("student_notes")
}

// =============================================================================
//  ATTENDANCE CAPTURE — QR self-service + manual.
//
//  A lecturer OPENS an AttendanceSession for a ClassSession, which mints a
//  short-lived QR token. Students scan the QR and submit their own student code;
//  each submission is an AttendanceCheckIn. If the code matches an enrolment in
//  the section it becomes an AttendanceRecord (rule engine decides present/late/
//  absent). If it does not match, the check-in stays PENDING and the lecturer
//  resolves it with a reason (make-up from another section, wrong code, late
//  registration, …). Manual marking writes AttendanceRecord directly.
// =============================================================================

enum AttendanceCheckInStatus {
  PENDING
  MATCHED
  REJECTED
}

enum AttendanceResolutionReason {
  MAKEUP_OTHER_SECTION
  WRONG_CODE
  LATE_REGISTRATION
  OTHER
}

model AttendanceSession {
  id             String    @id @default(cuid())
  classSessionId String
  token          String    @unique
  openedById     String?
  openedAt       DateTime  @default(now())
  expiresAt      DateTime
  isOpen         Boolean   @default(true)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  classSession ClassSession        @relation(fields: [classSessionId], references: [id])
  checkIns     AttendanceCheckIn[]

  @@index([classSessionId])
  @@map("attendance_sessions")
}

model AttendanceCheckIn {
  id                  String                      @id @default(cuid())
  attendanceSessionId String
  classSessionId      String
  enteredCode         String
  status              AttendanceCheckInStatus     @default(PENDING)
  matchedStudentId    String?
  matchedEnrollmentId String?
  /// Resulting attendance status when matched (rule-engine output).
  attendanceStatus    AttendanceStatus?
  minutesLate         Int?
  reason              AttendanceResolutionReason?
  reasonNote          String?
  resolvedById        String?
  resolvedAt          DateTime?
  ipAddress           String?
  createdAt           DateTime                    @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id])

  @@index([classSessionId, status])
  @@index([attendanceSessionId])
  @@map("attendance_checkins")
}

// =============================================================================
//  REPORTS — every generated report is registered so its QR code links back to
//  a public verification endpoint (authenticity + tamper-evidence via checksum).
// =============================================================================

enum ReportFormat {
  PDF
  CSV
  XLSX
}

model Report {
  id              String       @id @default(cuid())
  universityId    String
  reportNumber    String       @unique
  type            String // e.g. "ATTENDANCE_SUMMARY"
  title           String
  format          ReportFormat
  params          Json?
  /// SHA-256 of the report payload for tamper-evidence.
  checksum        String?
  generatedById   String?
  generatedByName String?
  createdAt       DateTime     @default(now())

  university University @relation(fields: [universityId], references: [id])

  @@index([universityId, createdAt])
  @@map("reports")
}

// =============================================================================
//  ASSESSMENT / GRADEBOOK — weighted rubrics (2-level: section% → item%),
//  per-student × per-section evaluations rated 1–5, and an editable grade
//  scheme (score bands → A–F) for cutting the combined grade.
// =============================================================================

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

/// A rubric template (e.g. "Clinical Evaluation 70%"). weightPercent is its
/// share of the final grade; the set of a course's rubrics is meant to total 100.
model Rubric {
  id            String    @id @default(cuid())
  universityId  String
  code          String?
  nameEn        String
  nameTh        String?
  description   String?
  /// Overall weight toward the final grade (e.g. 70). Default suggestion —
  /// actual grading weight per subject comes from SubjectRubric.weightPercent.
  weightPercent Float     @default(0)
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  university     University      @relation(fields: [universityId], references: [id])
  sections       RubricSection[]
  evaluations    Evaluation[]
  subjectRubrics SubjectRubric[]

  @@index([universityId])
  @@map("rubrics")
}

/// A weighted group of items within a rubric (e.g. "I. Nursing Performance 40%").
/// Rubrics without natural groups use one section at 100%.
model RubricSection {
  id            String  @id @default(cuid())
  rubricId      String
  nameEn        String
  nameTh        String?
  /// Weight of this section within the rubric (sections sum ≤ 100).
  weightPercent Float   @default(0)
  order         Int     @default(0)

  rubric Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  items  RubricItem[]

  @@index([rubricId])
  @@map("rubric_sections")
}

/// A scoreable sub-item, rated 1..maxRating.
model RubricItem {
  id            String  @id @default(cuid())
  sectionId     String
  textEn        String
  textTh        String?
  /// Weight of this item within its section (items sum ≤ 100). Editable.
  weightPercent Float   @default(0)
  maxRating     Int     @default(5)
  order         Int     @default(0)
  /// Must-pass step (e.g. a safety-critical action). Failing it forces the
  /// whole rubric's score to 0 regardless of the numeric rating elsewhere —
  /// mirrors OSCE-style "critical failure" grading used for clinical skills.
  isCritical    Boolean @default(false)

  section RubricSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  scores  EvaluationScore[]

  @@index([sectionId])
  @@map("rubric_items")
}

/// Which rubrics a Subject uses for grading, and at what weight within that
/// subject (a subject need not use all rubrics — active ones should sum ≤ 100).
/// This is the curriculum-level configuration; grading resolves a section's
/// weights via its Subject.
model SubjectRubric {
  id            String  @id @default(cuid())
  subjectId     String
  rubricId      String
  weightPercent Float   @default(0)
  isActive      Boolean @default(true)
  order         Int     @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  rubric  Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@unique([subjectId, rubricId])
  @@index([subjectId])
  @@map("subject_rubrics")
}

/// One filled-in rubric for a student (optionally within a class section).
model Evaluation {
  id             String           @id @default(cuid())
  universityId   String
  rubricId       String
  studentId      String
  sectionId      String?
  evaluatorId    String?
  evaluatorName  String?
  status         EvaluationStatus @default(DRAFT)
  /// Computed 0–100 weighted score for this rubric.
  scorePercent   Float?
  /// True if any isCritical item was marked not-passed — scorePercent is
  /// forced to 0 in that case, but this flag makes the reason explicit
  /// instead of looking like an ordinary zero score.
  criticalFailed Boolean          @default(false)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  university University        @relation(fields: [universityId], references: [id])
  rubric     Rubric            @relation(fields: [rubricId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])
  section    Section?          @relation(fields: [sectionId], references: [id])
  scores     EvaluationScore[]

  @@unique([rubricId, studentId, sectionId])
  @@index([universityId])
  @@index([studentId])
  @@index([sectionId])
  @@map("evaluations")
}

model EvaluationScore {
  id           String   @id @default(cuid())
  evaluationId String
  rubricItemId String
  rating       Int
  /// Only meaningful when the item is isCritical; null for non-critical items.
  passed       Boolean?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rubricItem RubricItem @relation(fields: [rubricItemId], references: [id])

  @@unique([evaluationId, rubricItemId])
  @@index([rubricItemId])
  @@map("evaluation_scores")
}

/// Editable grade scheme: score bands → letter grade + GPA.
model GradeScheme {
  id           String   @id @default(cuid())
  universityId String
  name         String   @default("Default")
  isDefault    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University  @relation(fields: [universityId], references: [id])
  bands      GradeBand[]

  @@index([universityId])
  @@map("grade_schemes")
}

model GradeBand {
  id       String @id @default(cuid())
  schemeId String
  grade    String // "A", "A-", ...
  gpa      Float
  label    String // "Excellent", ...
  /// Minimum combined score (0–100) to earn this grade. Editable per use.
  minScore Float
  order    Int    @default(0)

  scheme GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId])
  @@map("grade_bands")
}
