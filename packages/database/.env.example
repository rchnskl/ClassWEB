# Copy to .env and adjust as needed.
# Matches the docker-compose Postgres service.
DATABASE_URL="postgresql://classweb:classweb_dev_password@localhost:5432/classweb?schema=public"
# Same value locally (no connection pooler to route around) — required because
# `prisma migrate` reads it directly. Against Neon in production this must be
# the DIRECT (non-pooled) endpoint, not the "-pooler" one DATABASE_URL uses.
DIRECT_URL="postgresql://classweb:classweb_dev_password@localhost:5432/classweb?schema=public"
