{
  "name": "@classweb/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and seed data for the ClassWeb platform (source of truth for the data model)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/_preview_full_schema.sql && echo 'Wrote prisma/migrations/_preview_full_schema.sql'",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "format": "prisma format",
    "validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
