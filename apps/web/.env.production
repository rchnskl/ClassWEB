# Baked into the client bundle at build time by Next.js. Committed on purpose:
# NEXT_PUBLIC_* values ship inside the browser JS anyway, so this is not a
# secret — and leaving it to whoever runs the deploy is what silently shipped
# a production build pointing at http://localhost:3001.
NEXT_PUBLIC_API_URL=https://classweb-api.onrender.com/api/v1
