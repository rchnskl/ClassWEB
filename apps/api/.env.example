# Copy to .env and set real secrets (min 16 chars each; use distinct values).
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://classweb:classweb_dev_password@localhost:5432/classweb?schema=public"
# `prisma migrate` runs over this instead of DATABASE_URL — same value locally,
# but in production this must be Neon's DIRECT (non-pooled) endpoint. See the
# datasource comment in packages/database/prisma/schema.prisma for why.
DIRECT_URL="postgresql://classweb:classweb_dev_password@localhost:5432/classweb?schema=public"

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

CORS_ORIGINS="http://localhost:3000"

# --- Notifications (all optional — each channel degrades gracefully if unset) ---
# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ClassWeb <no-reply@nursing.au.edu>"

# LINE Messaging API — create a Messaging API channel at https://developers.line.biz/
# and use its Channel Access Token. Each user links their LINE user id separately.
LINE_CHANNEL_ACCESS_TOKEN=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@nursing.au.edu"

# --- Backup storage (production: use S3-compatible object storage, e.g. Cloudflare R2) ---
# 'local' writes to ./storage/backups (dev / single always-on host only — ephemeral on containers).
# 's3' uploads to R2/S3 (required for Cloudflare Containers, Fly, Railway, etc.).
BACKUP_STORAGE=local
# R2 endpoint looks like: https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=classweb-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
