# Copy to .env and set real secrets (min 16 chars each; use distinct values).
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://classweb:classweb_dev_password@localhost:5432/classweb?schema=public"

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

CORS_ORIGINS="http://localhost:3000"
